# Copy to `.env.local` (git-ignored) and fill in. Vite bakes these in at build time.

# Public site origin, no trailing slash. Used for canonical URLs, OG tags, sitemap.
VITE_SITE_URL=https://netpoc.com

# Where the PoC and Contact forms POST their JSON (Formspree form URL,
# Google Apps Script web-app URL, or our own API). Unset = forms show an error.
VITE_FORM_ENDPOINT=

# GA4 measurement ID (G-XXXXXXXXXX). Loaded only after the visitor accepts
# analytics cookies. Unset = no analytics script and no consent banner.
VITE_GA_ID=
